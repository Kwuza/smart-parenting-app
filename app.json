{
  "expo": {
    "name": "Smart Parenting App",
    "slug": "smart-parenting-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartparenting.app"
    },
    "android": {
      "package": "com.smartparenting.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "smart-parenting-app",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e370c421-ef23-42ee-9152-5289495207fc"
      }
    },
    "owner": "smart-parenting",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e370c421-ef23-42ee-9152-5289495207fc"
    }
  }
