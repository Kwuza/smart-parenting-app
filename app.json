{
  "expo": {
    "name": "Smart Parenting App",
    "slug": "smart-parenting-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartparenting.app"
    },
    "android": {
      "package": "com.smartparenting.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "main": "index.js",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "smart-parenting-app",
    "experiments": {
      "typedRoutes": true
    }
  }
}
