-- ═══════════════════════════════════════════════════════════════
-- Smart Parenting App — Test Account Seed Script
-- ═══════════════════════════════════════════════════════════════
-- 
-- Creates: 1 test parent + 2 children + routines + 28 days of
-- activities + AI recommendations + alerts
--
-- PREREQUISITES:
--   1. Run database/schema.sql first. It now includes the base tables,
--      RLS, triggers, avatar storage setup, scheduled activities, and all
--      former incremental migrations.
--
-- HOW TO RUN:
-- Option A (Dashboard):
--   1. Go to Supabase Dashboard → Authentication → Users
--   2. Create a development user with your own test email/password
--   3. Copy the user UUID
--   4. Replace 'YOUR_USER_UUID' below with that UUID
--   5. Run this template's contents in SQL Editor
--
-- Option B (Script):
--   1. SUPABASE_URL=https://your-project.supabase.co \
--      TEST_PASSWORD=<dev-password> \
--      node scripts/create_test_user.js <service_role_key>
--   2. Copy the printed UUID into the placeholder below
--   3. Run this template's contents in SQL Editor
--
-- ═══════════════════════════════════════════════════════════════

-- Step 1: Set your test user UUID here
-- Replace this with the UUID from the auth user you created
DO $$
DECLARE
  test_parent_id UUID := 'YOUR_USER_UUID';  -- ← REPLACE THIS
  child1_id UUID;
  child2_id UUID;
  today DATE := CURRENT_DATE;
  d DATE;
  hour_offset INT;
BEGIN


-- ═══════════════════════════════════════════
-- CHILD 1: Emma (age 3 — toddler, routines required)
-- ═══════════════════════════════════════════

INSERT INTO children (id, parent_id, name, date_of_birth, avatar_url,
  bedtime, wake_up_time, breakfast_time, lunch_time, snack_time, dinner_time,
  nap_time, activity_time, learn_time,
  height_cm, weight_kg, gender,
  max_screen_time_minutes, min_sleep_minutes
) VALUES (
  gen_random_uuid(), test_parent_id, 'Emma', (today - INTERVAL '3 years 4 months')::DATE, '👧',
  '20:00:00', '07:00:00', '08:00:00', '12:00:00', '15:00:00', '18:00:00',
  '13:00:00', '10:00:00', '09:00:00',
  96.5, 14.2, 'female',
  120, 600
) RETURNING id INTO child1_id;

-- ═══════════════════════════════════════════
-- CHILD 2: Noah (age 1 — toddler, routines required)
-- ═══════════════════════════════════════════

INSERT INTO children (id, parent_id, name, date_of_birth, avatar_url,
  bedtime, wake_up_time, breakfast_time, lunch_time, snack_time, dinner_time,
  nap_time, activity_time, learn_time,
  height_cm, weight_kg, gender,
  max_screen_time_minutes, min_sleep_minutes
) VALUES (
  gen_random_uuid(), test_parent_id, 'Noah', (today - INTERVAL '1 year 8 months')::DATE, '👦',
  '19:30:00', '06:30:00', '07:30:00', '11:30:00', '14:30:00', '17:30:00',
  '12:30:00', '09:30:00', '10:00:00',
  82.3, 11.5, 'male',
  60, 720
) RETURNING id INTO child2_id;

RAISE NOTICE 'Created children: Emma=%, Noah=%', child1_id, child2_id;

-- ═══════════════════════════════════════════
-- ACTIVITIES: 28 days of data for both children
-- ═══════════════════════════════════════════

FOR d IN SELECT generate_series(today - INTERVAL '27 days', today, '1 day'::INTERVAL)::DATE LOOP

  -- ─── EMMA's activities ───

  -- Screen time (varies: 45min-2h, leisure or educational)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'screen_time', jsonb_build_object(
      'hours', (ARRAY[0,0,1,1,1,0,1])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'minutes', (ARRAY[30,45,0,15,30,45,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'device', (ARRAY['tablet','tv','phone'])[1 + (EXTRACT(DOW FROM d)::INT % 3)],
      'category', CASE WHEN EXTRACT(DOW FROM d)::INT % 3 = 0 THEN 'educational' ELSE 'leisure' END
    ), d + TIME '10:00:00');

  -- Sleep (varies: 9-11 hours)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'sleep', jsonb_build_object(
      'hours', (ARRAY[10,10,9,10,11,10,9])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'minutes', (ARRAY[0,30,0,15,0,30,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'quality', (ARRAY['good','good','excellent','good','excellent','fair','good'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '07:00:00');

  -- Nap
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'nap', jsonb_build_object(
      'hours', 1,
      'minutes', (ARRAY[0,30,0,30,0,0,30])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'quality', 'good'
    ), d + TIME '13:00:00');

  -- Meal (varied foods)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'meal', jsonb_build_object(
      'meal_type', 'breakfast',
      'food', (ARRAY['oatmeal with banana','scrambled eggs','pancakes','cereal with milk','toast with jam','yogurt with berries','french toast'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', 'most'
    ), d + TIME '08:00:00');

  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'meal', jsonb_build_object(
      'meal_type', 'lunch',
      'food', (ARRAY['chicken rice','spaghetti','fish fillet','adobo with rice','sinigang','sandwich','fried chicken'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', 'all'
    ), d + TIME '12:00:00');

  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'meal', jsonb_build_object(
      'meal_type', 'dinner',
      'food', (ARRAY['grilled fish + veggies','chicken soup','beef stew','pork chop + rice','pancit','tapsilog','meatballs + pasta'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', 'most'
    ), d + TIME '18:00:00');

  -- Education
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'education', jsonb_build_object(
      'hours', (ARRAY[0,1,0,1,0,1,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'minutes', (ARRAY[0,30,0,0,0,30,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'subject', (ARRAY['alphabet','numbers','colors','shapes','reading','drawing','writing'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '09:00:00');

  -- Physical activity
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child1_id, 'physical_activity', jsonb_build_object(
      'hours', 0,
      'minutes', (ARRAY[30,45,60,30,45,60,30])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'activity', (ARRAY['running','playground','dancing','cycling','swimming','ball games','hide and seek'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '16:00:00');

  -- ─── NOAH's activities ───

  -- Screen time (minimal for 1yo: 0-30min)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'screen_time', jsonb_build_object(
      'hours', 0,
      'minutes', (ARRAY[0,15,0,20,0,30,15])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'device', 'tablet',
      'category', 'educational'
    ), d + TIME '10:30:00');

  -- Sleep (varies: 10-12 hours)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'sleep', jsonb_build_object(
      'hours', (ARRAY[11,11,10,12,11,10,11])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'minutes', (ARRAY[0,30,0,0,0,30,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'quality', (ARRAY['excellent','good','good','excellent','good','fair','good'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '06:30:00');

  -- Nap (longer for 1yo: 1.5-2.5h)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'nap', jsonb_build_object(
      'hours', (ARRAY[2,1,2,1,2,1,2])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'minutes', (ARRAY[0,30,0,30,0,30,0])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'quality', (ARRAY['excellent','good','good','excellent','good','good','excellent'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '12:30:00');

  -- Meals
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'meal', jsonb_build_object(
      'meal_type', 'breakfast',
      'food', (ARRAY['breastmilk + porridge','mashed banana + cereal','scrambled egg','oatmeal','yogurt + fruit','toast strips','pancake bites'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', (ARRAY['most','all','some','most','all','most','some'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '07:30:00');

  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'meal', jsonb_build_object(
      'meal_type', 'lunch',
      'food', (ARRAY['pureed chicken + rice','mashed sweet potato','lentil soup','fish + veggies','pasta + sauce','steamed veggies + tofu','rice porridge'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', (ARRAY['all','most','some','all','most','some','all'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '11:30:00');

  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'meal', jsonb_build_object(
      'meal_type', 'dinner',
      'food', (ARRAY['chicken puree + rice','veggie soup','mashed potato + fish','baby pasta','rice + steamed carrots','lentil mash','fruit + yogurt'])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'amount', (ARRAY['most','all','some','most','all','some','most'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '17:30:00');

  -- Physical activity (tummy time / crawling / walking practice)
  INSERT INTO activities (child_id, type, value, recorded_at) VALUES
    (child2_id, 'physical_activity', jsonb_build_object(
      'hours', 0,
      'minutes', (ARRAY[45,60,30,60,45,30,60])[1 + EXTRACT(DOW FROM d)::INT % 7],
      'activity', (ARRAY['crawling practice','walking with support','tummy time','playground','ball play','climbing stairs','dancing'])[1 + EXTRACT(DOW FROM d)::INT % 7]
    ), d + TIME '15:00:00');

END LOOP;

RAISE NOTICE 'Seeded 28 days of activities for both children';

-- ═══════════════════════════════════════════
-- AI RECOMMENDATIONS
-- ═══════════════════════════════════════════

-- Emma's recommendations
INSERT INTO recommendations (child_id, content, category, priority, based_on, created_at) VALUES
  (child1_id,
   'Emma is doing well with consistent sleep patterns averaging 10 hours. Consider gradually reducing screen time on weekends — her tablet usage spikes to 2 hours on Saturdays. Replace with outdoor play for better physical development.',
   'sleep', 'medium',
   jsonb_build_object(
     'period', (today - INTERVAL '27 days')::TEXT || ' to ' || today::TEXT,
     'activity_summary', jsonb_build_object(
       'sleep', jsonb_build_object('avg_hours', 10.1, 'consistency', 'good'),
       'screen_time', jsonb_build_object('avg_minutes', 55, 'weekend_avg', 90)
     ),
     'model', 'openrouter/elephant-alpha'
   ),
   today - INTERVAL '3 days' + TIME '10:00:00');

INSERT INTO recommendations (child_id, content, category, priority, based_on, created_at) VALUES
  (child1_id,
   'Great progress on alphabet recognition! Emma completed 4 educational sessions this week. Try introducing simple 3-letter words to build on her letter-sound association skills.',
   'education', 'low',
   jsonb_build_object(
     'period', (today - INTERVAL '7 days')::TEXT || ' to ' || today::TEXT,
     'activity_summary', jsonb_build_object(
       'education', jsonb_build_object('sessions', 4, 'subjects', ARRAY['alphabet','numbers','colors','reading'])
     ),
     'model', 'openrouter/elephant-alpha'
   ),
   today - INTERVAL '1 day' + TIME '14:00:00');

INSERT INTO recommendations (child_id, content, category, priority, based_on, created_at) VALUES
  (child1_id,
   'Physical activity is consistent at 30-60 min daily. Excellent! Swimming sessions could be increased to twice weekly — it builds core strength and coordination at this age.',
   'activity', 'low',
   jsonb_build_object(
     'period', (today - INTERVAL '14 days')::TEXT || ' to ' || today::TEXT,
     'model', 'openrouter/elephant-alpha'
   ),
   today + TIME '09:00:00');

-- Noah's recommendations
INSERT INTO recommendations (child_id, content, category, priority, based_on, created_at) VALUES
  (child2_id,
   'Noah''s sleep is excellent at 11+ hours average. His nap consistency is good but some days only get 1 hour — try to maintain the 2-hour nap window for optimal development at 20 months.',
   'sleep', 'high',
   jsonb_build_object(
     'period', (today - INTERVAL '27 days')::TEXT || ' to ' || today::TEXT,
     'activity_summary', jsonb_build_object(
       'sleep', jsonb_build_object('avg_hours', 11.2, 'consistency', 'excellent'),
       'nap', jsonb_build_object('avg_hours', 1.7)
     ),
     'model', 'openrouter/elephant-alpha'
   ),
   today - INTERVAL '2 days' + TIME '11:00:00');

INSERT INTO recommendations (child_id, content, category, priority, based_on, created_at) VALUES
  (child2_id,
   'Screen time is minimal (under 20 min avg) — perfect for this age. Keep it educational and interactive. Walking practice is going well — consider adding more outdoor time for sensory exploration.',
   'activity', 'medium',
   jsonb_build_object(
     'period', (today - INTERVAL '14 days')::TEXT || ' to ' || today::TEXT,
     'model', 'openrouter/elephant-alpha'
   ),
   today + TIME '08:00:00');

RAISE NOTICE 'Seeded 5 recommendations';

-- ═══════════════════════════════════════════
-- ALERTS
-- ═══════════════════════════════════════════

INSERT INTO alerts (child_id, type, message, severity, acknowledged, created_at) VALUES
  (child1_id, 'screen_time', 'Emma exceeded daily screen time limit (120 min) — logged 150 min on tablet today', 'warning', true, today - INTERVAL '5 days' + TIME '17:00:00');

INSERT INTO alerts (child_id, type, message, severity, acknowledged, created_at) VALUES
  (child1_id, 'sleep', 'Emma had less than 9 hours of sleep last night', 'info', true, today - INTERVAL '3 days' + TIME '08:00:00');

INSERT INTO alerts (child_id, type, message, severity, acknowledged, created_at) VALUES
  (child2_id, 'meal', 'Noah skipped lunch today — ensure adequate nutrition', 'warning', false, today - INTERVAL '1 day' + TIME '13:00:00');

INSERT INTO alerts (child_id, type, message, severity, acknowledged, created_at) VALUES
  (child2_id, 'routine', 'Noah''s bedtime was 45 min late last night', 'info', false, today + TIME '07:00:00');

RAISE NOTICE 'Seeded 4 alerts';

-- ═══════════════════════════════════════════
-- DONE
-- ═══════════════════════════════════════════

RAISE NOTICE '═════════════════════════════════════════';
RAISE NOTICE 'SEED COMPLETE — Test Account Ready!';
RAISE NOTICE 'Parent UUID: %', test_parent_id;
RAISE NOTICE 'Child 1 (Emma, 3y4m): %', child1_id;
RAISE NOTICE 'Child 2 (Noah, 1y8m): %', child2_id;
RAISE NOTICE '═════════════════════════════════════════';
RAISE NOTICE 'Login with the development email/password you created in Supabase Auth.';

END $$;
